#!/bin/sh
# Run a command inside the rebar dev container (PHP 8.3 + Rust), with the repo at /work.
# The Rust extension is loaded via docker/php.d/rebar.ini once it has been built.
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TTY=""; [ -t 0 ] && [ -t 1 ] && TTY="-it"
exec docker run --rm $TTY --shm-size=1g -v "$ROOT":/work \
  -v rebar-cargo:/usr/local/cargo/registry -v rebar-target:/work/ext/target \
  -v rebar-composer:/root/.cache/composer \
  -e PHP_INI_SCAN_DIR=/usr/local/etc/php/conf.d:/work/docker/php.d \
  ${REBAR_DOCKER_ARGS:-} -w "/work/${REBAR_WORKDIR:-drupal}" rebar-dev "$@"
